{
  "enable_enhance": {
    "description": "SubAgent 语音增强",
    "type": "bool",
    "default": true,
    "hint": "开启后调用 LLM 按 Provider 能力自动注入情感标签与指令控制"
  },
  "enhance_llm_provider": {
    "description": "TTS 增强模型",
    "type": "string",
    "_special": "select_provider",
    "hint": "用于生成情感标签与指令的模型；留空则用当前会话聊天模型",
    "default": ""
  },
  "context_window": {
    "description": "SubAgent 上下文窗口",
    "type": "int",
    "default": 10,
    "hint": "取最近几轮对话作为 SubAgent 的上下文参考"
  },
  "dual_output": {
    "description": "同时输出文本和语音",
    "type": "bool",
    "default": false,
    "hint": "开启后，TTS 段落会同时保留文本和语音消息"
  },
  "tts_prompt": {
    "description": "TTS 触发提示词",
    "type": "text",
    "default": "当你想要发送语音时，使用 <tts></tts> 标签包裹需要转换为语音的文字。使用标签触发 TTS 相较使用工具触发能减少一轮工具调用，节约对话轮数。工具更适用于在 Agent Loop 中顺手发送语音",
    "hint": "提示词注入主模型"
  },
  "synthesis_record_max": {
    "description": "合成记录保留份数",
    "type": "int",
    "default": 50,
    "hint": "0 或负数表示关闭合成记录落盘（不再记录新合成，但既有的记录仍可查看 / 删除）；正整数表示仅保留最近 N 份，超出自动删除最旧的；不支持「不限制」"
  },
  "page_background": {
    "description": "管理页背景图",
    "type": "file",
    "file_types": [
      "png",
      "jpg",
      "jpeg",
      "webp"
    ],
    "default": [],
    "hint": "为 TTS 管理页设置背景图；留空则不显示背景。仅支持单张图片。建议图片不要过大（如控制在数 MB 内），过大将拖慢页面加载"
  },
  "page_background_opacity": {
    "description": "背景图不透明度",
    "type": "float",
    "default": 0.5,
    "slider": {
      "min": 0,
      "max": 1,
      "step": 0.05
    },
    "hint": "背景图的不透明度（0 完全透明，1 完全不透明）"
  },
  "page_background_blur": {
    "description": "背景图模糊度",
    "type": "int",
    "default": 0,
    "slider": {
      "min": 0,
      "max": 30,
      "step": 1
    },
    "hint": "背景图的模糊半径（像素）"
  },
  "memory_retrieval_top_k": {
    "description": "记忆召回条数",
    "type": "int",
    "default": 0,
    "hint": "LivingMemory 联动：需安装 LivingMemory 插件才可用，未安装则记忆检索不生效；召回返回的长期记忆条数，0 = 关闭记忆检索"
  },
  "memory_retrieval_query_strategy": {
    "description": "检索关键词来源",
    "type": "string",
    "default": "user_message",
    "options": [
      "user_message",
      "prefix"
    ],
    "hint": "user_message=用待合成文本作关键词；prefix=用固定前缀"
  },
  "memory_retrieval_prefix": {
    "description": "固定检索前缀",
    "type": "text",
    "default": "用户语音偏好",
    "condition": {
      "memory_retrieval_query_strategy": "prefix"
    },
    "hint": "仅在检索关键词来源为 prefix 时生效"
  },
  "providers": {
    "type": "template_list",
    "description": "TTS 供应商列表（支持多个，按 priority 回退）",
