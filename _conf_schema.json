{
  "enable_enhance": {
    "description": "启用 SubAgent 语音增强",
    "type": "bool",
    "default": true,
    "hint": "开启后，插件会额外调用 LLM 根据 Provider 能力说明书自动注入情感标签和指令控制"
  },
  "enhance_llm_provider": {
    "description": "TTS 增强模型",
    "type": "string",
    "_special": "select_provider",
    "hint": "选择用于生成 TTS 情感标签和指令的模型。若未选择，将使用当前会话的聊天模型",
    "default": ""
  },
  "context_window": {
    "description": "SubAgent 上下文窗口",
    "type": "int",
    "default": 10,
    "hint": "取最近几轮对话作为 SubAgent 的上下文参考"
  },
  "dual_output": {
    "description": "同时输出文本和语音",
    "type": "bool",
    "default": false,
    "hint": "开启后，TTS 段落会同时保留文本和语音消息"
  },
  "tts_prompt": {
    "description": "TTS 触发提示词（注入主模型）",
    "type": "text",
    "default": "使用标签触发 TTS 相较使用工具触发能减少一轮工具调用，节约对话轮数。工具更适用于在 Agent Loop 中顺手发送语音"
  },
  "log_enhanced_params": {
    "description": "打印增强参数",
    "type": "bool",
    "default": false,
    "hint": "开启后，会在 INFO 级别记录 SubAgent 生成的语音参数（含情感标签、音量、语速等）"
  },
  "providers": {
    "type": "template_list",
    "description": "TTS 供应商列表（支持多个，按 priority 回退）",
    "templates": {
      "bailian_qwen_audio_3_0_tts": {
        "name": "百炼 Qwen Audio 3.0 TTS",
        "hint": "支持情感标签和指令控制",
        "display_item": "display_name",
        "items": {
          "display_name": {
            "description": "显示名称",
            "type": "string",
            "default": "Qwen Audio 3.0 TTS",
            "hint": "此供应商配置的显示名称（用于区分多个相同类型的供应商）"
          },
          "priority": {
            "description": "优先级（数字越小越优先）",
            "type": "int",
            "default": 0
          },
          "api_key": {
            "description": "API Key",
            "type": "string",
            "default": ""
          },
          "workspace_id": {
            "description": "Workspace ID",
            "type": "string",
            "default": ""
          },
          "model": {
            "description": "模型版本",
            "type": "string",
            "options": ["flash", "plus"],
            "default": "flash"
          },
          "voice": {
            "description": "音色 ID",
            "type": "string",
            "default": "longanhuan_v3.6"
          },
          "timeout": {
            "description": "超时时间",
            "type": "int",
            "default": 60,
            "hint": "单位：秒。合成较长文本时可能需要增加此值。调用超时与下载超时共用此值"
          },
          "format": {
            "description": "音频格式",
            "type": "string",
            "default": "wav",
            "options": ["wav", "mp3", "pcm", "opus"]
          },
          "sample_rate": {
            "description": "采样率",
            "type": "int",
            "default": 24000,
            "options": [8000, 16000, 22050, 24000, 44100, 48000]
          },
          "seed": {
            "description": "随机种子",
            "type": "int",
            "default": -1,
            "hint": "若设置为 [0, 65535] 之内的数字，则会固定种子，在模型版本、文本、音色及其他参数均相同的前提下，每次生成的音频都相同；若设置在该范围之外，则会随机生成种子"
          },
          "enable_aigc_tag": {
            "description": "AIGC 隐性标识",
            "type": "bool",
            "default": false,
            "hint": "开启时，会将隐性标识嵌入到支持格式（wav/mp3/opus）的音频中"
          },
          "aigc_propagator": {
            "description": "传播者标识",
            "type": "string",
            "default": "",
            "hint": "设置 AIGC 隐性标识中的 ContentPropagator 字段，用于标识内容的传播者。仅在 AIGC 隐性标识开启时生效。留空则使用默认值：阿里云UID"
          },
          "aigc_propagate_id": {
            "description": "传播行为 ID",
            "type": "string",
            "default": "",
            "hint": "设置 AIGC 隐性标识中的 PropagateID 字段，用于唯一标识一次具体的传播行为。仅在 AIGC 隐性标识开启时生效。留空则使用默认值：本次语音合成请求 Request ID"
          }
        }
      },
      "bailian_cosyvoice_v3_5": {
        "name": "百炼 CosyVoice 3.5",
        "hint": "不支持情感标签，支持指令控制",
        "display_item": "display_name",
        "items": {
          "display_name": {
            "description": "显示名称",
            "type": "string",
            "default": "CosyVoice 3.5",
            "hint": "此供应商配置的显示名称（用于区分多个相同类型的供应商）"
          },
          "priority": {
            "description": "优先级（数字越小越优先）",
            "type": "int",
            "default": 0
          },
          "api_key": {
            "description": "API Key",
            "type": "string",
            "default": ""
          },
          "workspace_id": {
            "description": "Workspace ID",
            "type": "string",
            "default": ""
          },
          "model": {
            "description": "模型版本",
            "type": "string",
            "options": ["flash", "plus"],
            "default": "flash"
          },
          "voice": {
            "description": "音色 ID",
            "type": "string",
            "default": "",
            "hint": "CosyVoice v3.5 不支持系统音色，请使用声音复刻或声音设计生成的音色 ID"
          },
          "timeout": {
            "description": "超时时间",
            "type": "int",
            "default": 60,
            "hint": "单位：秒。合成较长文本时可能需要增加此值。调用超时与下载超时共用此值"
          },
          "format": {
            "description": "音频格式",
            "type": "string",
            "default": "wav",
            "options": ["wav", "mp3", "pcm", "opus"]
          },
          "sample_rate": {
            "description": "采样率",
            "type": "int",
            "default": 24000,
            "options": [8000, 16000, 22050, 24000, 44100, 48000]
          },
          "seed": {
            "description": "随机种子",
            "type": "int",
            "default": -1,
            "hint": "若设置为 [0, 65535] 之内的数字，则会固定种子，在模型版本、文本、音色及其他参数均相同的前提下，每次生成的音频都相同；若设置在该范围之外，则会随机生成种子"
          },
          "enable_aigc_tag": {
            "description": "AIGC 隐性标识",
            "type": "bool",
            "default": false,
            "hint": "开启时，会将隐性标识嵌入到支持格式（wav/mp3/opus）的音频中"
          },
          "aigc_propagator": {
            "description": "传播者标识",
            "type": "string",
            "default": "",
            "hint": "设置 AIGC 隐性标识中的 ContentPropagator 字段，用于标识内容的传播者。仅在 AIGC 隐性标识开启时生效。留空则使用默认值：阿里云UID"
          },
          "aigc_propagate_id": {
            "description": "传播行为 ID",
            "type": "string",
            "default": "",
            "hint": "设置 AIGC 隐性标识中的 PropagateID 字段，用于唯一标识一次具体的传播行为。仅在 AIGC 隐性标识开启时生效。留空则使用默认值：本次语音合成请求 Request ID"
          }
        }
      },
      "minimax_speech_2_8": {
        "name": "Minimax Speech 2.8",
        "hint": "支持语气词标签、LaTeX 朗读",
        "display_item": "display_name",
        "items": {
          "display_name": {
            "description": "显示名称",
            "type": "string",
            "default": "Minimax Speech 2.8",
            "hint": "此供应商配置的显示名称（用于区分多个相同类型的供应商）"
          },
          "priority": {
            "description": "优先级（数字越小越优先）",
            "type": "int",
            "default": 0
          },
          "api_key": {
            "description": "API Key",
            "type": "string",
            "default": ""
          },
          "voice_id": {
            "description": "音色 ID",
            "type": "string",
            "default": "lovely_girl"
          },
          "model": {
            "description": "模型版本",
            "type": "string",
            "options": ["HD", "Turbo"],
            "default": "HD"
          },
          "timeout": {
            "description": "超时时间",
            "type": "int",
            "default": 60,
            "hint": "单位：秒。合成较长文本时可能需要增加此值"
          },
          "text_normalization": {
            "description": "文本规范化",
            "type": "bool",
            "default": true,
            "hint": "开启后，模型会对文本进行规范化处理，如将数字转换为中文读法等"
          },
          "sample_rate": {
            "description": "采样率",
            "type": "int",
            "default": 32000,
            "options": [8000, 16000, 22050, 24000, 32000, 44100]
          },
          "format":{
            "description": "音频格式",
            "type": "string",
            "default": "mp3",
            "options": ["wav", "mp3", "pcm", "opus", "flac", "pcmu_raw", "pcmu_wav"]
          },
          "bitrate": {
            "description": "比特率",
            "type": "int",
            "default": 128000,
            "options": [32000, 64000, 128000, 256000],
            "hint": "仅在音频格式为 mp3 时生效"
          },
          "channel": {
            "description": "声道数",
            "type": "int",
            "default": 1,
            "options": [1, 2],
            "hint": "1 为单声道，2 为立体声"
          }
        }
      }
    }
  }
}